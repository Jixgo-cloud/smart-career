# SmartCareer Environment Configuration Template
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection (use separate database per environment)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartcareer_dev?schema=public"

# JWT & Session Security (minimum 32 characters)
JWT_SECRET="replace-with-secure-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Origins & URLs
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
API_URL="http://localhost:4000/api"

# GitHub OAuth (Candidate Login & Context Sync)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:4000/api/auth/github/callback"
GITHUB_TOKEN=""

# Google OAuth (Company Login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

# Judge0 Code Execution Engine (Remote Sandbox Only)
JUDGE0_BASE_URL=""
JUDGE0_API_URL=""
JUDGE0_API_KEY=""
JUDGE0_AUTH_HEADER="X-RapidAPI-Key"
RAPIDAPI_KEY=""

# Google Gemini AI (Open-Ended Grading & Skill Extraction)
GEMINI_API_KEY=""
AI_EVALUATOR_MODEL="gemini-2.5-flash"

# External Job & Course Ingestion Providers
JSEARCH_API_KEY=""
JSEARCH_API_URL="https://jsearch.p.rapidapi.com/search"
YOUTUBE_API_KEY=""
UDEMY_CLIENT_ID=""
UDEMY_CLIENT_SECRET=""
INGESTION_CONFIG_DIR="./apps/api/config"

# Browser Automation
PUPPETEER_EXECUTABLE_PATH=""
PUPPETEER_HEADLESS="true"

# Admin Bootstrap & Guards (Do not leave true in production)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ENABLE_DEV_MOCK_AUTH="false"
NEXT_PUBLIC_SHOW_DEMO_LOGIN="false"
ALLOW_PRODUCTION_SEED="false"

# Docker Compose PostgreSQL
POSTGRES_DB="smartcareer"
POSTGRES_USER="smartcareer"
POSTGRES_PASSWORD="change-me-in-production"
